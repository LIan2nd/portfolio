# ==========================================
# Google Analytics & Tracking Configuration
# ==========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ==========================================
# MONGODB ATLAS Configuration
# Persistent storage for chat history, AI settings/knowledge, portfolio
# projects/experience, and contact messages.
# ==========================================
MONGODB_URI=mongodb+srv://XXXXXXXXXX
MONGODB_DB=db_name

# ==========================================
# AI Portfolio Assistant Configuration
# ==========================================

# 1. NARA AI Gateway (Primary Provider)
NARA_BASE_URL=https://router.bynara.id/v1
NARA_API_KEY=
NARA_MODEL=muse-spark-1.3-contributor-free

# 2. SumoPod AI Gateway (Secondary / Fallback)
# SUMOPOD_API_KEY=
# SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
# SUMOPOD_MODEL=mimo-v2.5
# SUMOPOD_EMBEDDING_MODEL=gemini/gemini-embedding-001

# 3. Alternative Providers (Optional)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=

# ==========================================
# Contact Form Configuration
# ==========================================
CONTACT_SCRIPT_URL=

# Private admin API for the personal dashboard (server only)
DASHBOARD_API_TOKEN=

# ==========================================
# Cloudflare R2 Gallery Storage
# Create an R2 API token with Object Read & Write access. R2_PUBLIC_BASE_URL
# should be the bucket's public custom domain (without a trailing slash).
# Browser uploads also require a bucket CORS rule allowing PUT from Dashboard.
# ==========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://gallery.example.com
